# Payment gateway configuration
# Copy to .env and fill in your values. NEVER commit the real service role key.

PORT=3000

# Supabase (same project as the app)
SUPABASE_URL=https://kollnkzommrfkvogwhjn.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# REQUIRED for the gateway to finalize payments (set status to "Paid").
# Find it in Supabase Dashboard -> Project Settings -> API -> service_role (secret).
# NEVER put this key in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Test mode: payment auto-completes after N ms so you can test the flow for free.
PAYNOW_TEST_MODE=true
PAYNOW_TEST_AUTO_COMPLETE_MS=10000

# Product
SUBSCRIPTION_AMOUNT=5
SUBSCRIPTION_DESCRIPTION=1 Month Premium Access
PAYNOW_AUTHEMAIL=infinitymetersolutions@gmail.com

# Real Paynow (leave empty to stay in test mode)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PUBLIC_BASE_URL=http://localhost:3000
